# Example M.A.N.A.T.O.-RS configuration.
#
# Copy this file, adjust the paths, then run:
#   cargo run -p manato-app -- --config manato.toml
#
# Command-line flags override values from this file. Relative character and
# stage paths are resolved against `root`; a relative `root` is resolved
# against the directory containing this file.

root = "."

# Character definition files.
p1 = "content/chars/kaen/kaen.def"
p2 = "content/chars/nival/nival.def"

# Stage definition file.
stage = "content/stages/training/stage1.def"

# Optional screenpack system.def. With --menu the bundled Manato Grid
# is used when this is unset; `--screenpack none` forces the built-in HUD.
screenpack = "content/screenpacks/manato-grid/system.def"

# CPU level for slot 2. Set to 0 for local two-player.
ai = 6

# Rounds needed to win and round timer in seconds.
rounds = 2
round_time = 99

# Window integer scale (320x240 * scale).
scale = 3

# Optional keyboard remapping. Any omitted key keeps its default.
# P1 defaults: WASD + J/K/L (X/Y/Z) + U/I/O (A/B/C) + Enter.
# P2 defaults: arrows + numpad 1/2/3 (X/Y/Z) + 4/5/6 (A/B/C) + Numpad0.
[input.p1]
up = "w"
down = "s"
left = "a"
right = "d"
x = "j"
y = "k"
z = "l"
a = "u"
b = "i"
c = "o"
start = "enter"

[input.p2]
up = "arrowup"
down = "arrowdown"
left = "arrowleft"
right = "arrowright"
x = "numpad1"
y = "numpad2"
z = "numpad3"
a = "numpad4"
b = "numpad5"
c = "numpad6"
start = "numpad0"
