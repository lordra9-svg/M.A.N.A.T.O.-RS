; Purpose-built oracle fixture for O-20: persistent HitDef with a forced
; airborne target state. Installed into a throwaway runtime by run_frame_capture.sh.
[Statedef 7000]
type    = S
movetype= A
physics = S
velset  = 0,0
anim    = 200
ctrl    = 0
juggle  = 15

[State 7000, Persistent HitDef]
type = HitDef
trigger1 = 1
attr = S, NA
damage = 10, 0
guardflag = MA
hitflag = MAF
pausetime = 0, 0
ground.type = High
ground.velocity = 0
air.velocity = 0, 0
p2stateno = 7001
fall = 1
numhits = 2

[Statedef 7001]
type    = A
movetype= H
physics = N
anim    = 5030
ctrl    = 0

[State 7001, Lift]
type = PosSet
trigger1 = Time = 0
y = -20

[State 7001, Freeze]
type = VelSet
trigger1 = 1
x = 0
y = 0

; Guard-damage probe (K-09). Requires Options.GuardBreak = 1.
[Statedef 7002]
type = S
movetype = A
physics = S
anim = 200
ctrl = 0

[State 7002, Guard damage]
type = HitDef
trigger1 = Time = 0
attr = S, NA
damage = 10, 10
guardflag = MA
hitflag = MAF
pausetime = 0, 0

; Dizzy probe. Requires Options.Dizzy = 1.

[State 7002, End]
type = ChangeState
trigger1 = Time >= 8
value = 0
ctrl = 1

[Statedef 7003]
type = S
movetype = A
physics = S
anim = 200
ctrl = 0

[State 7003, Dizzy damage]
type = HitDef
trigger1 = Time = 0
attr = S, NA
damage = 20
guardflag = MA
hitflag = MAF
pausetime = 0, 0

[State 7003, End]
type = ChangeState
trigger1 = Time >= 8
value = 0
ctrl = 1


